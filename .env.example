# ===== 简历与岗位匹配助手 · 环境变量模板 =====
# 使用方式：复制本文件为 .env，填入真实值后 docker compose --env-file .env up
# .env 已加入 .gitignore，真实密钥不会提交到仓库。

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=resume_matcher
MYSQL_USER=resume
MYSQL_PASSWORD=change-me-db

# ---- 大模型（DeepSeek，OpenAI 兼容）----
# 可选：作为「兜底」key。用户未在界面配置自己的 API Key 时，将回退使用此环境变量。
# 留空则要求用户登录后在右上角「设置 API Key」自行配置。
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- JWT 签名密钥（请替换为足够长的随机串）----
JWT_SECRET=change-me-to-a-long-random-secret-string
